# Source Postgres (docker compose). Standard libpq names, so psql and psycopg read them directly.
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=pagila

# Snowflake connection name from ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION=pagila

# Used by Soda data source configs (soda/datasources/), which can't read connections.toml
SNOWFLAKE_ACCOUNT=<account identifier from connections.toml>
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.snowflake/pagila_rsa_key.p8
